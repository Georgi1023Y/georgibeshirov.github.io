# Copy to .env and fill in from your Supabase project (Settings > API).
# These values are safe to ship in the browser; never put the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Function `submit-contact` secrets — set in Supabase Dashboard
# (Project Settings → Edge Functions → Secrets), NOT in Vite:
#   SUPABASE_URL              (auto on hosted)
#   SUPABASE_SERVICE_ROLE_KEY  (server only)
#   RESEND_API_KEY            (https://resend.com)
#   NOTIFY_TO_EMAIL           (your inbox)
#   RESEND_FROM               (e.g. Portfolio <onboarding@resend.dev> or your verified domain)
