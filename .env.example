# Copy to .env and fill in from your Supabase project (Settings > API).
# These values are safe to ship in the browser; never put the service_role key here.
#
# GitHub Pages: add the same names as *repository* secrets
# (Settings → Secrets and variables → Actions) so the deploy workflow can build with
# Vite env injection. Missing secrets → see browser console: "Missing GitHub Secrets/Env Vars"

VITE_SUPABASE_URL=
# Use the **anon** / **public** client key for this project (Dashboard → Settings → API).
# Prefer the JWT that starts with `eyJ...` ("anon" "public"). If inserts return **401 Unauthorized**,
# the key is wrong for REST: recopy from the same project, or switch from publishable to legacy anon JWT.
VITE_SUPABASE_ANON_KEY=

# Edge Function `submit-contact` secrets — set in Supabase Dashboard
# (Project Settings → Edge Functions → Secrets), NOT in Vite:
#   SUPABASE_URL              (auto on hosted)
#   SUPABASE_SERVICE_ROLE_KEY  (server only)
#   RESEND_API_KEY            (https://resend.com)
#   NOTIFY_TO_EMAIL           (your inbox)
#   RESEND_FROM               (e.g. Portfolio <onboarding@resend.dev> or your verified domain)
